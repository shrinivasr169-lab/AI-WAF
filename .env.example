# AI-WAF configuration example
# Copy to `.env` and adjust. Never commit a real `.env`.

# --- server ---------------------------------------------------------------
WAF_HOST=127.0.0.1
WAF_PORT=8000

# Local lab target the gateway forwards permitted traffic to.
# Leave empty to use the built-in echo responder (no upstream).
UPSTREAM_URL=

# --- decision policy ------------------------------------------------------
# monitor = log + alert only (never blocks). enforce = allow/block.
WAF_MODE=monitor

# --- inspection limits ----------------------------------------------------
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=10
RULE_SCAN_LIMIT=10000

# --- rate limiting (per client, 0 disables) -------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Only set this when a trusted reverse proxy sets the header; otherwise any
# client could spoof its identity.
TRUSTED_PROXY_HEADER=

# --- ML -------------------------------------------------------------------
ML_ENABLED=true
ML_MODEL_PATH=models/model.joblib
# Empty = use the thresholds calibrated during training (recommended).
ML_ALERT_THRESHOLD=
ML_BLOCK_THRESHOLD=
# Keep false until precision/recall have been measured (conservative default).
ML_BLOCKING_ENABLED=false

# --- audit log ------------------------------------------------------------
DB_PATH=data/events.db
LOG_RETENTION_DAYS=30
